#!/bin/bash
# 本应用是**纯前端 + CGI 轻量入口**，没有常驻进程 ——
# 所以 start/stop 都是空操作，status 恒为「运行中」（退出码 0）。
#
# 官方文档：框架会周期性探测应用状态；「若应用自身内置守护进程，可以不使用模板提供的
# PID 文件进行探测，改为检测应用提供的 status 结果」。这里正是这种情形。

case $1 in
start)
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    # 0 = 运行中（本应用没有需要守护的进程）
    exit 0
    ;;
*)
    exit 1
    ;;
esac
