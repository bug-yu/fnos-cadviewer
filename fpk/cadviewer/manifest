appname               = cadviewer
version               = 0.2.4
display_name          = CAD 查看器
desc                  = 基于 mlightcad/cad-viewer 的 DWG/DXF 查看器：文件管理器右键预览用「简易查看器」，桌面图标打开「完整版」。可打开飞牛 NAS 上自己有权限的图纸，也能打开本地文件。
source                = thirdparty
platform              = all

maintainer            = bug-yu
distributor           = bug-yu
distributor_url       = https://github.com/bug-yu

os_min_version        = 1.2.0

desktop_uidir         = ui
desktop_applaunchname = cadviewer.Application

# ★★ 必须声明：官方文档明确说「未声明 micro_app=true 时，应用页面不会按微应用环境加载，
#    JS SDK 相关能力可能无法初始化」—— 而本应用的核心就是 JS SDK 的 pickUserFile。
micro_app             = true

changelog             = 0.2.4：修「图纸加载后画面全黑」—— 库版本不匹配。上游示例把 @mlightcad/libredwg-converter 写成 ^3.15.0（带插入符），而 @mlightcad/data-model 精确钉在 1.15.0；这两个包是同日成对发布的（1.15.0/3.15.0 相隔 26 秒），但插入符让 converter 装到了 3.15.2（10-06 发布），它调用了 data-model 还没有的 setImportedXData() → 转换阶段抛 TypeError → 画面全黑（控制台可见）。现在把 converter 钉死 3.15.0 与 data-model 1.15.0 对齐，并提交 pnpm-lock.yaml 防再次漂移。0.2.3：修 openAppAuth 的回调地址 —— redirectUri 原来写的是相对路径 ./callback.html，被解析成了站点根 /callback.html → 选完文件跳到飞牛的 404 页。现在按当前页面路径在运行时推算（…/index.cgi/index.html → …/index.cgi/callback.html），部署到任何前缀下都对。真机确认整个授权流程是通的：授权页正常弹出（「请选择文件 · 授权应用访问」+ 文件树）、选完 status=success。另外回调页加了一层兜底：如果 SDK 解析不出路径，就直接从回调 URL 的查询串里找。0.2.2：桌面图标打开时不再弹「没有收到文件路径」（那不是错误 —— 桌面打开本来就没有文件），改为准备首页：新增「打开 NAS 上的图纸」按钮，按运行环境自动分流 —— 在飞牛桌面窗口内直接调 pickUserFile（弹出飞牛自己的选择器，选完返回已授权路径）；在独立浏览器标签里（桌面图标是 type:url）改走 openAppAuth 弹授权页，结果由新增的 callback.html 解析后 postMessage 送回原页面。按钮下方会显示当前运行环境，便于排查。0.2.1：修「右键预览报 HTTP 400：缺少 path 参数」—— 页面发的查询参数是 filePath（沿用 FileView 那套页面的补丁），而 0.2.0 的 CGI 只认 path，于是每次都判「缺少参数」。现在两个名字都认（qget_path）。顺带在本地把 CGI 跑了一遍端到端测试：静态文件、字体、wasm 的 MIME、api/raw 的参数名与 URL 解码（中文路径）、api/diag 的身份输出，全部通过。0.2.0：P1 —— 正式接上 CAD 查看器。两个入口：① 文件管理器右键「用 CAD 查看器打开」→ type=iframe（飞牛桌面窗口内）② 桌面图标「CAD 查看器」→ type=url（浏览器新标签）。页面与资源直接复用 FileView 那套已构建好的产物（完整版 cad-viewer + 86 个 SHX 字体 + LibreDWG WASM，共 79 MB），两个入口共享同一份资源。新增 CGI 两个 API：/api/raw 读文件给查看器（只允许 /vol 下绝对路径、拒绝 ..、检查可读性）、/api/diag 诊断（打印当前身份 + 目标路径的可见性/可读性/ACL —— 用来回答「后端能不能读未授权的文件」这个安全前提）。0.1.3：修「桌面图标打开 404」的真因 —— 入口配置里的 "protocol"/"port" 被框架拿去拼 URL。0.1.2：改用「安装回调补权限」的正确做法。0.1.1：修包内 CGI 可执行位缺失。0.1.0：P0 验证版 —— 验证 pickUserFile 在桌面窗口可用。

# 不监听固定端口（用 CGI 轻量入口，protocol/port 会被忽略）
checkport             = false
