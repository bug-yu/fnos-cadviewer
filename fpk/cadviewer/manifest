appname               = cadviewer
version               = 0.1.3
display_name          = CAD 查看器
desc                  = 基于 mlightcad/cad-viewer 的 DWG/DXF 查看器：文件管理器右键预览用「简易查看器」，桌面图标打开「完整版」。可打开飞牛 NAS 上自己有权限的图纸，也能打开本地文件。
source                = thirdparty
platform              = all

maintainer            = bug-yu
distributor           = bug-yu
distributor_url       = https://github.com/bug-yu

os_min_version        = 1.2.0

desktop_uidir         = ui
desktop_applaunchname = cadviewer.Application

# ★★ 必须声明：官方文档明确说「未声明 micro_app=true 时，应用页面不会按微应用环境加载，
#    JS SDK 相关能力可能无法初始化」—— 而本应用的核心就是 JS SDK 的 pickUserFile。
micro_app             = true

changelog             = 0.1.3：修「桌面图标打开 404」的真因 —— 入口配置里照抄了官方 CGI 示例的 "protocol": "http" / "port": "8080"，而实际 NAS 不在 8080（用户访问的是 :566）→ 框架按 8080 拼出 URL → 打开就 404。官方文档说「CGI 入口 protocol 和 port 不参与路由」，但**实测框架仍然用它拼了 URL**（F12 里能看到请求打到了 10.10.6.125:8080）→ 现在把这两个字段整个去掉，只留 url。0.1.2：改用「安装回调补权限」的正确做法 —— 0.1.1 试图打完包再改 fpk 里的可执行位，结果被飞牛判「不是有效的 fpk 文件」（fpk 尾部有完整性校验，改了内容就失效）。现在改为在 cmd/install_callback 与 cmd/upgrade_callback 里 chmod +x app/ui/index.cgi。0.1.1：修「桌面图标打开 404」—— 包里的 app/ui/index.cgi 是可执行权限缺失（0666）。官方文档说打包工具会处理可执行权限，但 fnpack.exe 在 Windows 上读不到 chmod +x，所以打出来的包在 NAS 上不可执行，CGI 入口就 404。0.1.0：P0 验证版 —— 只验证一件事：飞牛开放 API 的 pickUserFile（选择文件/目录并授权给应用）能不能在**桌面窗口**里使用。

# 不监听固定端口（用 CGI 轻量入口，protocol/port 会被忽略）
checkport             = false
