appname               = cadviewer
version               = 0.2.0
display_name          = CAD 查看器
desc                  = 基于 mlightcad/cad-viewer 的 DWG/DXF 查看器：文件管理器右键预览用「简易查看器」，桌面图标打开「完整版」。可打开飞牛 NAS 上自己有权限的图纸，也能打开本地文件。
source                = thirdparty
platform              = all

maintainer            = bug-yu
distributor           = bug-yu
distributor_url       = https://github.com/bug-yu

os_min_version        = 1.2.0

desktop_uidir         = ui
desktop_applaunchname = cadviewer.Application

# ★★ 必须声明：官方文档明确说「未声明 micro_app=true 时，应用页面不会按微应用环境加载，
#    JS SDK 相关能力可能无法初始化」—— 而本应用的核心就是 JS SDK 的 pickUserFile。
micro_app             = true

changelog             = 0.2.0：P1 —— 正式接上 CAD 查看器。两个入口：① 文件管理器右键「用 CAD 查看器打开」→ type=iframe（飞牛桌面窗口内）② 桌面图标「CAD 查看器」→ type=url（浏览器新标签）。页面与资源直接复用 FileView 那套已构建好的产物（完整版 cad-viewer + 86 个 SHX 字体 + LibreDWG WASM，共 79 MB），两个入口共享同一份资源。新增 CGI 两个 API：/api/raw 读文件给查看器（只允许 /vol 下绝对路径、拒绝 ..、检查可读性）、/api/diag 诊断（打印当前身份 + 目标路径的可见性/可读性/ACL —— 用来回答「后端能不能读未授权的文件」这个安全前提）。0.1.3：修「桌面图标打开 404」的真因 —— 入口配置里的 "protocol"/"port" 被框架拿去拼 URL。0.1.2：改用「安装回调补权限」的正确做法。0.1.1：修包内 CGI 可执行位缺失。0.1.0：P0 验证版 —— 验证 pickUserFile 在桌面窗口可用。

# 不监听固定端口（用 CGI 轻量入口，protocol/port 会被忽略）
checkport             = false
